{
  "name": "new-rev-gen",
  "version": "0.1.0",
  "private": true,
  "description": "NewRevGen agency platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@newrevgen/website",
    "dev:website": "npm run dev --workspace=@newrevgen/website",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
