# This file is a variable catalog only. Copy only the variables required by an
# individual app into that app's local .env file. Never commit real secrets.

# Shared data layer
DATABASE_URL=
DIRECT_DATABASE_URL=

# Authentication and encryption
AUTH_SECRET=
DATA_ENCRYPTION_KEY=

# AI providers (enable only the providers in use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email and automation delivery
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
AUTOMATION_WEBHOOK_SECRET=

# Website lead tools -> Convex CRM (same shared secret on both sides)
CRM_CONVEX_SITE_URL=
CONVEX_LEAD_INGEST_SECRET=
WEBSITE_LEAD_INGEST_SECRET=
RATE_LIMIT_SALT=
# preview (default) or email-only
TOOL_RESULTS_GATE_MODE=preview

# Monitoring
ERROR_REPORTING_DSN=
